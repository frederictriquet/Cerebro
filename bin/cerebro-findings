#!/usr/bin/env node
// Publish structured findings during the review turn; this does not create backlog tasks.
import {request,requireSession,run,sessionPath} from './cerebro-client.mjs';
await run('cerebro-findings',async()=>{
  requireSession();
  process.stdin.setEncoding('utf8');
  let body='';for await(const chunk of process.stdin){body+=chunk;if(Buffer.byteLength(body)>1024*1024)throw new Error('Rapport trop volumineux.');}
  const result=await request(`${sessionPath('backlog')}/findings`,{method:'POST',body:JSON.parse(body)});
  process.stdout.write(`Rapport ${result.id} enregistré ; sélection disponible dans la session.\n`);
});
