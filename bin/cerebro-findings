#!/usr/bin/env node
// Publish structured findings during the review turn; this does not create backlog tasks.
const {CEREBRO_SESSION_ID:id,CEREBRO_TOKEN:token,CEREBRO_URL:base}=process.env;
try{
  if(!id||!token||!base)throw new Error('Commande à utiliser dans une session Cerebro.');
  process.stdin.setEncoding('utf8');
  let body='';for await(const chunk of process.stdin){body+=chunk;if(Buffer.byteLength(body)>1024*1024)throw new Error('Rapport trop volumineux.');}
  const payload=JSON.parse(body);
  const response=await fetch(`${base.replace(/\/+$/,'')}/api/backlog/${encodeURIComponent(id)}/findings`,{method:'POST',headers:{'content-type':'application/json','x-cerebro-token':token},body:JSON.stringify(payload),signal:AbortSignal.timeout(10000)});
  const result=await response.json();if(!response.ok)throw new Error(result.error??response.statusText);process.stdout.write(`Rapport ${result.id} enregistré ; sélection disponible dans la session.\n`);
}catch(cause){process.stderr.write(`${cause.message}\n`);process.exitCode=1;}
