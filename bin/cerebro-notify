#!/usr/bin/env node

import { request, requireSession, run, sessionPath } from './cerebro-client.mjs';

await run('cerebro-notify', async () => {
  requireSession();
  const args = process.argv.slice(2);
  const ask = args[0] === '--ask';
  if (ask) args.shift();

  let text = args.join(' ');
  if (text === '') {
    process.stdin.setEncoding('utf8');
    for await (const chunk of process.stdin) text += chunk;
    text = text.trim();
  }

  const result = await request(sessionPath('notify'), { method: 'POST', body: { kind: ask ? 'ask' : 'notify', text } });
  // Older servers answer without `queued`.
  const delivery =
    result?.queued === true
      ? 'en file (limite de débit Slack), envoi automatique dès la fin de la fenêtre'
      : 'envoyé sur Slack';
  process.stdout.write(
    ask
      ? `Question : ${delivery}. Termine ton tour maintenant : la réponse arrivera comme prochain message de l'utilisateur.\n`
      : `Message ${delivery}.\n`,
  );
});
