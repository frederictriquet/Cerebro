#!/usr/bin/env node

import { request, requireSession, run, sessionPath } from './cerebro-client.mjs';

await run('cerebro-notify', async () => {
  requireSession();
  const args = process.argv.slice(2);
  const ask = args[0] === '--ask';
  if (ask) args.shift();

  let text = args.join(' ');
  if (text === '') {
    process.stdin.setEncoding('utf8');
    for await (const chunk of process.stdin) text += chunk;
    text = text.trim();
  }

  await request(sessionPath('notify'), { method: 'POST', body: { kind: ask ? 'ask' : 'notify', text } });
  process.stdout.write(ask
    ? "Question envoyée sur Slack. Termine ton tour maintenant : la réponse arrivera comme prochain message de l'utilisateur.\n"
    : 'Message envoyé sur Slack.\n');
});
