{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/graphify\" ] || exit 0; exec \"$HOME/.local/bin/graphify\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/graphify\" ] || exit 0; exec \"$HOME/.local/bin/graphify\" hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}